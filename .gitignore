*.exe
*.dll
*.pak
*.utoc
*.ucas
*.uasset
*.uexp
*.ubulk
*.dmp
*.log
*.ghidra
*.gpr
*.rep
node_modules/

# Local-only profile paths and credentials/configuration
**/games.local.json
.env
.env.*

# Local catalogs, SQLite sidecars, and generated build output
*.sqlite
*.sqlite-*
*.db
**/bin/
**/obj/
**/.vs/

# Mapping files are local inputs and must not be published accidentally
*.usmap
*.jmap

# Full local IoStore extraction of proprietary game content (34,238 files); never publish
analysis/iostore-extract-*/
*.umap
*.uptnl
*.ushaderbytecode

# Unreal authoring project (unreal/example): track only the uproject, Config, Source and plugin source.
# Assets (Content, *.uasset) are generated by the scripts in tools/ue-editor and are never committed.
unreal/**/Content/
unreal/**/Intermediate/
unreal/**/Binaries/
unreal/**/Saved/
unreal/**/DerivedDataCache/
unreal/**/.vs/
unreal/**/*.sln
unreal/**/*.slnx
unreal/**/Config/DefaultEditorPerProjectUserSettings.ini
unreal/**/Config/DefaultInput.ini
unreal/**/Config/User*.ini
.gitnexus
.claude/skills/gitnexus/

# Per-game profiles: the example is tracked, local copies hold real paths
profiles/*.local.json

# Generated stand-ins for the game classes (derived from the proprietary usmap): local only
unreal/**/Plugins/*Stubs/

tools/bpdump/bin/
tools/bpdump/obj/

# Ubergraph publishes the manager only. Everything about a specific game (analysis, mods, notes) stays out of the base;
# copy .gitignore.example over this file if you want to version your own mods and analysis inside your copy.
/analysis/
/mods/
/config/*.local.*
/unreal/*/SourceArt/
# the author's own authoring project of the first game stays local (it holds the real Content/)
/unreal/VanillaPlusCPP/

# Python bytecode caches
__pycache__/
*.pyc
# the local links to the game repository (junctions look like files to git)
/analysis
/mods
